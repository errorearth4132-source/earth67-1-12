<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Network Architect: Wi-Fi Puzzle</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --qual-standard: #e5e7eb;
            --qual-standard-border: #9ca3af;
            --qual-good: #e9d5ff;
            --qual-good-border: #a855f7;
            --qual-high: #fef08a;
            --qual-high-border: #eab308;
            --qual-premium: #fecaca;
            --qual-premium-border: #ef4444;
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            overflow: hidden; /* Prevent body scroll, handle inside containers */
            touch-action: none; /* Prevent pinch zoom on mobile */
        }
        
        /* Scrollbars */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #1e293b; }
        ::-webkit-scrollbar-thumb { background: #475569; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #64748b; }

        /* Game Board Grid */
        #game-board-container {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, #1e293b 1px, transparent 1px),
                linear-gradient(to bottom, #1e293b 1px, transparent 1px);
            position: relative;
        }

        /* Quality Backgrounds */
        .q-bg-0 { background-color: var(--qual-standard); color: #1f2937; border: 2px solid var(--qual-standard-border); }
        .q-bg-1 { background-color: var(--qual-good); color: #4c1d95; border: 2px solid var(--qual-good-border); }
        .q-bg-2 { background-color: var(--qual-high); color: #713f12; border: 2px solid var(--qual-high-border); }
        .q-bg-3 { background-color: var(--qual-premium); color: #7f1d1d; border: 2px solid var(--qual-premium-border); }

        .q-text-0 { color: #9ca3af; }
        .q-text-1 { color: #a855f7; }
        .q-text-2 { color: #eab308; }
        .q-text-3 { color: #ef4444; }

        /* Animations */
        @keyframes pulse-border {
            0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(59, 130, 246, 0); }
            100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
        }
        .anim-pulse { animation: pulse-border 2s infinite; }
        
        .fade-in { animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* Cable Line */
        .cable-line {
            stroke-dasharray: 10;
            animation: dash 1s linear infinite;
        }
        @keyframes dash { to { stroke-dashoffset: -20; } }

        /* Minigame Wires */
        .wire-slot { min-height: 40px; }
        .wire-drag { cursor: grab; transition: transform 0.1s; }
        .wire-drag:active { cursor: grabbing; transform: scale(1.1); }
        
        /* Game Nodes */
        .game-node {
            position: absolute;
            width: 40px; height: 40px;
            display: flex; justify-content: center; align-items: center;
            border-radius: 8px; cursor: pointer;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            user-select: none;
            z-index: 10;
            transition: transform 0.1s;
        }
        .game-node:active { transform: scale(0.95); }
        .game-node .badge {
            position: absolute; top: -5px; right: -5px;
            font-size: 0.6rem; padding: 2px 4px; border-radius: 999px;
            background: #ef4444; color: white;
        }
        .node-router { background: linear-gradient(135deg, #3b82f6, #2563eb); border: 2px solid #60a5fa; }
        .node-switch { background: linear-gradient(135deg, #8b5cf6, #7c3aed); border: 2px solid #a78bfa; }
        .node-ap { background: linear-gradient(135deg, #10b981, #059669); border: 2px solid #34d399; }
        .node-pc { background: #475569; border: 2px solid #94a3b8; }
        .node-phone { background: #334155; border: 2px solid #64748b; border-radius: 50%; width: 30px; height: 30px; }
        .node-wall { background: #334155; position: absolute; z-index: 5; }
        .node-internet { background: #f59e0b; border: 2px solid #fbbf24; border-radius: 50%; z-index: 9;}

        /* Modals */
        .modal-bg { background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); }
        
        /* Minigame Tools */
        #cut-line { display: none; position: absolute; height: 100%; width: 2px; background: red; top: 0; pointer-events: none;}
    </style>
</head>
<body class="w-screen h-screen flex flex-col text-sm md:text-base">

    <header class="h-14 bg-slate-800 border-b border-slate-700 flex justify-between items-center px-4 shrink-0 z-50 shadow-md">
        <div class="flex items-center gap-2">
            <i class="fas fa-network-wired text-blue-400 text-xl"></i>
            <h1 class="font-bold text-lg hidden sm:block tracking-wide">Network Architect</h1>
        </div>
        <div class="flex items-center gap-4">
            <div class="bg-slate-900 px-4 py-1.5 rounded-full border border-slate-700 flex items-center gap-2">
                <i class="fas fa-coins text-yellow-400"></i>
                <span id="player-money" class="font-bold text-yellow-400 font-mono text-lg">3,000</span>
            </div>
        </div>
    </header>

    <main id="app-container" class="flex-1 relative overflow-hidden">
        
        <!-- Screen: Main Menu -->
        <section id="screen-main" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-900 z-10 fade-in">
            <div class="text-center mb-10">
                <i class="fas fa-wifi text-6xl text-blue-500 mb-4 drop-shadow-[0_0_15px_rgba(59,130,246,0.5)]"></i>
                <h2 class="text-4xl font-extrabold bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-emerald-400">Wi-Fi Setup Puzzle</h2>
                <p class="text-slate-400 mt-2">ออกแบบ ติดตั้ง และต่อระบบเครือข่ายให้สมบูรณ์</p>
            </div>
            <div class="flex flex-col gap-4 w-64">
                <button onclick="showScreen('level-select')" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition-transform transform hover:scale-105 flex items-center justify-center gap-2">
                    <i class="fas fa-play"></i> เข้าเกม
                </button>
                <button onclick="showScreen('shop')" class="bg-purple-600 hover:bg-purple-500 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition-transform transform hover:scale-105 flex items-center justify-center gap-2">
                    <i class="fas fa-box-open"></i> อุปกรณ์ / ร้านค้า
                </button>
                <button onclick="confirmReset()" class="bg-slate-700 hover:bg-red-600 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition-transform transform hover:scale-105 flex items-center justify-center gap-2">
                    <i class="fas fa-trash-alt"></i> รีเซ็ตข้อมูล
                </button>
            </div>
        </section>

        <!-- Screen: Shop & Inventory -->
        <section id="screen-shop" class="absolute inset-0 bg-slate-900 hidden z-10 flex flex-col">
            <div class="p-4 bg-slate-800 flex justify-between items-center shadow-md">
                <button onclick="showScreen('main')" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg flex items-center gap-2 transition">
                    <i class="fas fa-arrow-left"></i> กลับ
                </button>
                <div class="flex gap-2 bg-slate-900 p-1 rounded-lg">
                    <button id="tab-inventory" onclick="switchShopTab('inventory')" class="px-4 py-2 rounded-md bg-blue-600 font-bold transition">คลังไอเทม</button>
                    <button id="tab-store" onclick="switchShopTab('store')" class="px-4 py-2 rounded-md hover:bg-slate-700 transition">ร้านค้า</button>
                    <button id="tab-craft" onclick="switchShopTab('craft')" class="px-4 py-2 rounded-md hover:bg-slate-700 transition"><i class="fas fa-tools"></i> เข้าหัว LAN</button>
                </div>
            </div>
            
            <div class="flex-1 overflow-y-auto p-4 md:p-6" id="shop-content">
                <!-- Content injected via JS -->
            </div>
        </section>

        <!-- Screen: Level Select -->
        <section id="screen-level-select" class="absolute inset-0 bg-slate-900 hidden z-10 flex flex-col">
            <div class="p-4 bg-slate-800 flex items-center shadow-md">
                <button onclick="showScreen('main')" class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg flex items-center gap-2 transition">
                    <i class="fas fa-arrow-left"></i> กลับ
                </button>
                <h2 class="text-xl font-bold ml-4">เลือกด่าน</h2>
            </div>
            <div class="flex-1 flex flex-col items-center justify-center gap-6 p-4">
                <button onclick="startLevel(0)" class="w-full max-w-md bg-emerald-700 hover:bg-emerald-600 p-6 rounded-2xl flex items-center justify-between shadow-lg transition transform hover:-translate-y-1">
                    <div class="text-left">
                        <h3 class="text-2xl font-bold">ด่านง่าย (Easy)</h3>
                        <p class="text-emerald-200">เป้าหมาย: 3,000 คะแนน | อาคาร 1 ชั้น</p>
                    </div>
                    <i class="fas fa-building text-4xl text-emerald-400 opacity-50"></i>
                </button>
                <button onclick="startLevel(1)" class="w-full max-w-md bg-orange-700 hover:bg-orange-600 p-6 rounded-2xl flex items-center justify-between shadow-lg transition transform hover:-translate-y-1">
                    <div class="text-left">
                        <h3 class="text-2xl font-bold">ด่านกลาง (Normal)</h3>
                        <p class="text-orange-200">เป้าหมาย: 6,000 คะแนน | อาคาร 2-3 ชั้น</p>
                    </div>
                    <i class="fas fa-city text-4xl text-orange-400 opacity-50"></i>
                </button>
                <button onclick="startLevel(2)" class="w-full max-w-md bg-red-800 hover:bg-red-700 p-6 rounded-2xl flex items-center justify-between shadow-lg transition transform hover:-translate-y-1">
                    <div class="text-left">
                        <h3 class="text-2xl font-bold">ด่านยาก (Hard)</h3>
                        <p class="text-red-200">เป้าหมาย: 12,000 คะแนน | อาคาร 2-4 ชั้น</p>
                    </div>
                    <i class="fas fa-industry text-4xl text-red-400 opacity-50"></i>
                </button>
            </div>
        </section>

        <!-- Screen: Game Board -->
        <section id="screen-game" class="absolute inset-0 bg-slate-900 hidden flex flex-col md:flex-row z-10">
            <!-- Left Panel: Game Inventory / Tools -->
            <div class="w-full md:w-80 bg-slate-800 flex flex-col border-r border-slate-700 z-20 shadow-xl h-48 md:h-full order-2 md:order-1">
                <div class="p-3 bg-slate-900 border-b border-slate-700 flex justify-between items-center">
                    <div>
                        <div class="text-xs text-slate-400">เป้าหมาย</div>
                        <div class="font-bold text-emerald-400 text-lg" id="game-target-score">0 pts</div>
                    </div>
                    <button onclick="abandonLevel()" class="text-red-400 hover:text-red-300 px-2 py-1"><i class="fas fa-times"></i> ออก</button>
                </div>
                
                <div class="flex p-2 gap-2 bg-slate-800">
                    <button id="tool-place" onclick="setTool('place')" class="flex-1 bg-blue-600 py-1.5 rounded text-sm font-bold shadow"><i class="fas fa-hand-pointer"></i> วางอุปกรณ์</button>
                    <button id="tool-wire" onclick="setTool('wire')" class="flex-1 bg-slate-700 py-1.5 rounded text-sm font-bold shadow"><i class="fas fa-plug"></i> ต่อสาย</button>
                    <button id="tool-delete" onclick="setTool('delete')" class="flex-1 bg-slate-700 py-1.5 rounded text-sm font-bold shadow"><i class="fas fa-eraser"></i> ลบ</button>
                </div>

                <div id="game-inventory-list" class="flex-1 overflow-y-auto p-2 space-y-2">
                    <!-- Inventory items for placement -->
                </div>

                <div class="p-3 bg-slate-900 border-t border-slate-700">
                    <button onclick="testNetwork()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 rounded-lg shadow-lg flex items-center justify-center gap-2 anim-pulse">
                        <i class="fas fa-check-circle"></i> ตรวจสอบระบบ
                    </button>
                </div>
            </div>

            <!-- Right Panel: Grid -->
            <div class="flex-1 relative overflow-auto bg-slate-950 order-1 md:order-2" id="board-scroll-area">
                <div id="game-board-container" class="w-[1200px] h-[1200px] transform origin-top-left">
                    <!-- SVG for Cables -->
                    <svg id="cables-svg" class="absolute inset-0 w-full h-full pointer-events-none z-10">
                        <defs>
                            <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
                                <polygon points="0 0, 10 3.5, 0 7" fill="#60a5fa" />
                            </marker>
                        </defs>
                    </svg>
                    <!-- Elements (Nodes/Walls) injected here -->
                </div>
            </div>
            
            <!-- Connection UI (Floating) -->
            <div id="connection-ui" class="absolute top-4 left-1/2 transform -translate-x-1/2 bg-slate-800 border border-blue-500 p-4 rounded-xl shadow-2xl hidden z-50">
                <div class="text-center font-bold mb-2">เลือกสาย LAN เพื่อเชื่อมต่อ</div>
                <div class="text-xs text-slate-400 mb-2 text-center" id="connection-nodes-info">Node A ➔ Node B</div>
                <div id="connection-cables-list" class="max-h-40 overflow-y-auto space-y-1"></div>
                <button onclick="cancelConnection()" class="mt-2 w-full bg-slate-700 py-1 rounded text-sm">ยกเลิก</button>
            </div>
        </section>

    </main>

    <!-- Modal: Generic Alert / Confirm -->
    <div id="modal-alert" class="absolute inset-0 modal-bg hidden z-50 flex items-center justify-center p-4">
        <div class="bg-slate-800 border border-slate-600 p-6 rounded-2xl max-w-md w-full shadow-2xl transform transition-transform scale-95" id="modal-alert-content">
            <h3 id="modal-title" class="text-xl font-bold mb-2 text-white">หัวข้อ</h3>
            <p id="modal-desc" class="text-slate-300 mb-6 whitespace-pre-wrap">รายละเอียด</p>
            <div id="modal-buttons" class="flex justify-end gap-3">
                <!-- Buttons injected -->
            </div>
        </div>
    </div>

    <!-- Modal: Minigame (Cable Crafting) -->
    <div id="modal-minigame" class="absolute inset-0 modal-bg hidden z-[60] flex items-center justify-center p-2">
        <div class="bg-slate-900 border-2 border-blue-500 rounded-xl w-full max-w-2xl h-[90vh] flex flex-col shadow-2xl relative overflow-hidden">
            <div class="bg-blue-600 text-white p-3 font-bold flex justify-between items-center shadow-md">
                <span><i class="fas fa-tools"></i> เข้าหัว LAN</span>
                <button onclick="closeMinigame()" class="hover:bg-blue-700 px-2 rounded"><i class="fas fa-times"></i></button>
            </div>
            <div class="p-2 bg-slate-800 text-center text-sm font-semibold border-b border-slate-700" id="mg-instruction">
                คำสั่ง
            </div>
            <div class="flex-1 relative bg-slate-800 overflow-hidden flex items-center justify-center" id="mg-area">
                <!-- Interactive elements injected here -->
            </div>
            <div class="p-4 bg-slate-900 border-t border-slate-700 flex justify-between items-center">
                <div class="text-xs text-slate-400 w-1/3">ความเสียหาย: <span id="mg-damage" class="text-red-400 font-bold">0%</span></div>
                <div class="w-1/3 text-center" id="mg-step-indicator">Step 1/6</div>
                <div class="w-1/3 text-right">
                    <button id="mg-btn-action" class="bg-blue-600 hover:bg-blue-500 px-4 py-2 rounded font-bold shadow hidden">ต่อไป</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal: Network Results -->
    <div id="modal-results" class="absolute inset-0 modal-bg hidden z-[60] flex items-center justify-center p-4">
        <div class="bg-slate-800 border-2 border-slate-600 rounded-2xl w-full max-w-2xl shadow-2xl flex flex-col max-h-[90vh]">
            <div class="p-4 border-b border-slate-700 text-center relative" id="result-header">
                <h2 class="text-3xl font-extrabold" id="result-title">ผลลัพธ์</h2>
            </div>
            <div class="p-4 flex-1 overflow-y-auto space-y-4 text-sm" id="result-details">
                <!-- Diagnostics -->
            </div>
            <div class="p-4 border-t border-slate-700 bg-slate-900 flex justify-between items-center rounded-b-2xl">
                <div class="font-bold text-lg">เงินรางวัล: <span id="result-money" class="text-yellow-400 font-mono">+0</span></div>
                <div class="flex gap-2">
                    <button id="btn-result-retry" onclick="restartLevel()" class="bg-orange-600 hover:bg-orange-500 px-4 py-2 rounded font-bold transition hidden">เล่นใหม่</button>
                    <button onclick="exitLevel()" class="bg-blue-600 hover:bg-blue-500 px-6 py-2 rounded font-bold transition">เสร็จสิ้น</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // --- 1. Constants & Configurations ---
        const QUALITIES = [
            { id: 0, name: 'มาตรฐาน', class: 'q-bg-0', textClass: 'q-text-0', multi: 1 },
            { id: 1, name: 'คุณภาพดี', class: 'q-bg-1', textClass: 'q-text-1', multi: 2 },
            { id: 2, name: 'คุณภาพสูง', class: 'q-bg-2', textClass: 'q-text-2', multi: 4 },
            { id: 3, name: 'พรีเมี่ยม', class: 'q-bg-3', textClass: 'q-text-3', multi: 8 }
        ];

        const CABLE_LENGTHS = [1, 3, 5, 10, 20, 50];
        const HEAD_PACKS = [20, 50, 100];

        // Base configurations for item types
        const DB = {
            uncrimped_cable: { type: 'cable_raw', name: 'สาย LAN (ไม่เข้าหัว)', basePrice: 40, unit: 'เมตร', icon: 'fa-tape' },
            crimped_cable: { type: 'cable_ready', name: 'สาย LAN (เข้าหัวสำเร็จ)', basePrice: 60, unit: 'เมตร', icon: 'fa-ethernet' },
            head: { type: 'head', name: 'หัวสาย LAN (RJ45)', basePrice: 4, unit: 'ชิ้น', icon: 'fa-plug' },
            ap_a: { type: 'ap', name: 'Access Point (Brand A)', basePrice: 800, maxUsersBase: 10, icon: 'fa-wifi' },
            ap_b: { type: 'ap', name: 'Access Point (Brand B)', basePrice: 850, maxUsersBase: 12, icon: 'fa-wifi' },
            router_a: { type: 'router', name: 'Router (Brand A)', basePrice: 1000, maxDev: [30, 40, 60, 80], maxSpeed: [45, 90, 130, 150], icon: 'fa-server' },
            router_b: { type: 'router', name: 'Router (Brand B)', basePrice: 1100, maxDev: [35, 45, 65, 85], maxSpeed: [50, 100, 140, 160], icon: 'fa-server' },
            switch_a: { type: 'switch', name: 'Network Switch (Brand A)', basePricePerPort: 50, configs: [{p:6, u:1}, {p:8, u:2}, {p:9, u:1}, {p:16, u:4}], icon: 'fa-network-wired' },
            switch_b: { type: 'switch', name: 'Network Switch (Brand B)', basePricePerPort: 55, configs: [{p:6, u:1}, {p:8, u:2}, {p:9, u:1}, {p:16, u:4}], icon: 'fa-network-wired' }
        };

        // Network Speed thresholds
        const SPEED = {
            mobile: { low: 1, med: 4 }, // <1 Low, 1-4 Med, >=4 High
            pc: { low: 3, med: 8 }      // <3 Low, 3-8 Med, >=8 High
        };
        const SCORE = { pcBase: 50, pcMed: 50, pcHigh: 100, pcMax: 100, phoneBase: 100, phoneMed: 50, phoneHigh: 100 };
        const CABLE_SPEEDS = [90, 200, 500, 1000]; // Speed limit by quality

        // --- 2. State Management ---
        let state = {
            money: 3000,
            inventory: [], // { id, dbId, q, size/port, amount }
            unlockedLevels: 1
        };

        let curTab = 'inventory';
        let mgState = {}; // Minigame state

        // Game Board State
        let game = {
            active: false,
            difficulty: 0,
            targetScore: 0,
            nodes: [], // { id, type, x, y, el, portsTotal, portsUsed, data:{} }
            cables: [], // { id, node1, node2, item: {q, size} }
            tool: 'place', // place, wire, delete
            selectedNodeId: null, // For wiring
            selectedInventoryIdx: null, // For placing
        };

        // --- STREAMING_CHUNK:Storage & Initialization ---
        function saveState() {
            localStorage.setItem('network_game_save', JSON.stringify(state));
            updateUI();
        }

        function loadState() {
            const saved = localStorage.getItem('network_game_save');
            if (saved) {
                try { state = JSON.parse(saved); } catch (e) { resetState(); }
            } else {
                resetState(false);
            }
            updateUI();
        }

        function resetState(save = true) {
            state = { money: 3000, inventory: [], unlockedLevels: 1 };
            // Give starter items
            addInv('crimped_cable', 0, 10, 5); // 5x 10m std cables
            addInv('router_a', 0, null, 1);
            addInv('switch_a', 0, '6+1', 1);
            if(save) saveState();
        }

        function updateUI() {
            document.getElementById('player-money').innerText = state.money.toLocaleString();
        }

        function generateId() { return Math.random().toString(36).substr(2, 9); }

        window.onload = () => {
            loadState();
            showScreen('main');
        };

        // --- STREAMING_CHUNK:Navigation & Modals ---
        function showScreen(id) {
            ['screen-main', 'screen-shop', 'screen-level-select', 'screen-game'].forEach(s => {
                document.getElementById(s).classList.add('hidden');
            });
            document.getElementById(`screen-${id}`).classList.remove('hidden');
            document.getElementById(`screen-${id}`).classList.add('fade-in');
            
            if(id === 'shop') switchShopTab('inventory');
        }

        function showAlert(title, desc, confirmTxt = 'ตกลง', onConfirm = null, cancelTxt = null, onCancel = null) {
            const modal = document.getElementById('modal-alert');
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-desc').innerText = desc;
            
            let btnsHtml = '';
            if (cancelTxt) btnsHtml += `<button id="btn-alert-cancel" class="bg-slate-600 hover:bg-slate-500 px-4 py-2 rounded">${cancelTxt}</button>`;
            btnsHtml += `<button id="btn-alert-confirm" class="bg-blue-600 hover:bg-blue-500 px-4 py-2 rounded font-bold shadow">${confirmTxt}</button>`;
            
            document.getElementById('modal-buttons').innerHTML = btnsHtml;
            modal.classList.remove('hidden');

            document.getElementById('btn-alert-confirm').onclick = () => {
                modal.classList.add('hidden');
                if(onConfirm) onConfirm();
            };
            if (cancelTxt) {
                document.getElementById('btn-alert-cancel').onclick = () => {
                    modal.classList.add('hidden');
                    if(onCancel) onCancel();
                };
            }
        }

        function confirmReset() {
            showAlert('ยืนยันการรีเซ็ต', 'คุณแน่ใจหรือไม่ว่าต้องการรีเซ็ตเกม?\nข้อมูลเงิน ไอเทม และความคืบหน้าทั้งหมดจะถูกลบ', 'ยืนยัน', () => {
                resetState();
                showAlert('สำเร็จ', 'รีเซ็ตข้อมูลเรียบร้อยแล้ว');
            }, 'ยกเลิก');
        }

        // --- STREAMING_CHUNK:Inventory System ---
        function addInv(dbId, q, size, amount) {
            let existing = state.inventory.find(i => i.dbId === dbId && i.q === q && i.size === size);
            if (existing) {
                existing.amount += amount;
            } else {
                state.inventory.push({ id: generateId(), dbId, q, size, amount });
            }
        }

        function removeInvItem(id, amount = 1) {
            let idx = state.inventory.findIndex(i => i.id === id);
            if(idx > -1) {
                state.inventory[idx].amount -= amount;
                if(state.inventory[idx].amount <= 0) state.inventory.splice(idx, 1);
                saveState();
                return true;
            }
            return false;
        }

        function getFullItemInfo(invItem) {
            const base = DB[invItem.dbId];
            const qual = QUALITIES[invItem.q];
            let title = `${base.name} (${qual.name})`;
            let detail = '';
            
            if(base.type === 'cable_raw' || base.type === 'cable_ready') title += ` ${invItem.size}ม.`;
            if(base.type === 'head') title += ` Pack ${invItem.size}`;
            if(base.type === 'switch') title += ` ${invItem.size} Port`;

            if(base.type === 'cable_ready') detail = `Speed Limit: ${CABLE_SPEEDS[invItem.q]} Mbps`;
            if(base.type === 'router') detail = `Max Devices: ${base.maxDev[invItem.q]} | Speed: ${base.maxSpeed[invItem.q]} Mbps`;
            if(base.type === 'ap') detail = `Max Users: ${base.maxUsersBase * qual.multi}`;

            return { title, detail, qClass: qual.class, icon: base.icon, type: base.type };
        }

        // --- STREAMING_CHUNK:Shop UI Logic ---
        function switchShopTab(tab) {
            curTab = tab;
            ['tab-inventory', 'tab-store', 'tab-craft'].forEach(t => document.getElementById(t).classList.remove('bg-blue-600', 'font-bold'));
            document.getElementById(`tab-${tab}`).classList.add('bg-blue-600', 'font-bold');
            renderShopContent();
        }

        function renderShopContent() {
            const container = document.getElementById('shop-content');
            container.innerHTML = '';

            if (curTab === 'inventory') {
                if (state.inventory.length === 0) {
                    container.innerHTML = '<div class="text-center text-slate-500 mt-10">ไม่มีไอเทมในคลัง</div>';
                    return;
                }
                let html = '<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">';
                state.inventory.forEach(item => {
                    const info = getFullItemInfo(item);
                    html += `
                    <div class="rounded-xl p-4 flex flex-col ${info.qClass} relative overflow-hidden shadow-md">
                        <div class="absolute top-2 right-2 bg-slate-900 text-white text-xs px-2 py-1 rounded font-bold">x${item.amount}</div>
                        <i class="fas ${info.icon} text-3xl mb-2 opacity-80"></i>
                        <h4 class="font-bold text-sm mb-1">${info.title}</h4>
                        <p class="text-xs opacity-80 mt-auto">${info.detail}</p>
                    </div>`;
                });
                html += '</div>';
                container.innerHTML = html;
            } 
            else if (curTab === 'store') {
                let html = '<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">';
                
                // Generate Store Items
                const storeItems = [];
                Object.keys(DB).forEach(dbId => {
                    const base = DB[dbId];
                    QUALITIES.forEach((q, qIdx) => {
                        if (base.type === 'cable_raw' || base.type === 'cable_ready') {
                            CABLE_LENGTHS.forEach(len => {
                                let price = base.basePrice * len * q.multi;
                                storeItems.push({dbId, qIdx, size: len, price, name: `${base.name} ${len}ม.`});
                            });
                        } else if (base.type === 'head') {
                            HEAD_PACKS.forEach(pack => {
                                let price = base.basePrice * pack * q.multi;
                                storeItems.push({dbId, qIdx, size: pack, price, name: `${base.name} Pack ${pack}`});
                            });
                        } else if (base.type === 'switch') {
                            base.configs.forEach(cfg => {
                                let totalPorts = cfg.p + cfg.u;
                                let price = base.basePricePerPort * totalPorts * q.multi;
                                storeItems.push({dbId, qIdx, size: `${cfg.p}+${cfg.u}`, price, name: `${base.name} ${cfg.p}+${cfg.u} Port`});
                            });
                        } else {
                            let price = base.basePrice * q.multi;
                            storeItems.push({dbId, qIdx, size: null, price, name: base.name});
                        }
                    });
                });

                storeItems.forEach(si => {
                    const qual = QUALITIES[si.qIdx];
                    const base = DB[si.dbId];
                    html += `
                    <div class="bg-slate-800 rounded-xl p-4 border border-slate-700 flex flex-col shadow-lg">
                        <div class="flex justify-between items-start mb-2">
                            <div class="px-2 py-0.5 text-xs rounded font-bold ${qual.class}">${qual.name}</div>
                            <div class="text-yellow-400 font-bold"><i class="fas fa-coins text-sm"></i> ${si.price.toLocaleString()}</div>
                        </div>
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 rounded-full bg-slate-700 flex items-center justify-center shrink-0">
                                <i class="fas ${base.icon} text-slate-300"></i>
                            </div>
                            <h4 class="font-bold text-sm leading-tight">${si.name}</h4>
                        </div>
                        <button onclick="buyItem('${si.dbId}', ${si.qIdx}, '${si.size}', ${si.price})" class="mt-auto w-full bg-blue-600 hover:bg-blue-500 py-2 rounded text-sm font-bold transition flex items-center justify-center gap-2">
                            <i class="fas fa-cart-plus"></i> ซื้อ
                        </button>
                    </div>`;
                });
                html += '</div>';
                container.innerHTML = html;
            }
            else if (curTab === 'craft') {
                renderCraftUI(container);
            }
        }

        function buyItem(dbId, q, size, price) {
            size = size === 'null' ? null : isNaN(size) ? size : Number(size);
            if (state.money >= price) {
                state.money -= price;
                addInv(dbId, q, size, 1);
                saveState();
                renderShopContent();
                // small visual feedback
                document.getElementById('player-money').classList.add('scale-125', 'text-white');
                setTimeout(()=>document.getElementById('player-money').classList.remove('scale-125', 'text-white'), 200);
            } else {
                showAlert('เงินไม่พอ', 'คุณมีเงินไม่พอซื้อไอเทมนี้');
            }
        }

        // --- STREAMING_CHUNK:Crafting Minigame UI & Logic ---
        function renderCraftUI(container) {
